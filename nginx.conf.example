# The server block of SLAED CMS for nginx, which reads no .htaccess: copy it into the configuration of the site and adjust
# server_name, root and fastcgi_pass. The document root is the folder public/ of the project and nothing above it,
# so core/, config/, storage/ and uploads/ never exist for the web. tests/Unit/NginxConfigTest.php keeps this file in step
# with public/.htaccess: whatever that file refuses inside public/, this one refuses too.

server {
    listen 80;
    server_name example.com;

    # The document root: the folder public/ of the project
    root /var/www/slaed/public;
    index index.php;
    charset utf-8;
    autoindex off;

    # Errors that PHP answers render the page of the site; 502 and 504 mean PHP is down, so the static page answers them
    fastcgi_intercept_errors off;
    error_page 400 401 402 403 404 500 503 /index.php?error=$status;
    error_page 502 504 /error.html;

    # Compression of the text types public/.htaccess deflates; text/html is always compressed once gzip is on
    # WOFF2/WOFF, images and archives are already compressed and are intentionally left out
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/javascript text/xml text/xsl application/javascript application/json application/xml
        application/xhtml+xml application/rss+xml application/xslt+xml application/opensearchdescription+xml image/svg+xml;

    # A style or script whose address carries the version of its content (?v=) is kept a year, any other a week; the
    # choice is made here, at the server level, because an if inside a location would drop its try_files
    set $asset_cache "public, max-age=604800";
    if ($arg_v) {
        set $asset_cache "public, max-age=31536000, immutable";
    }

    # No upload lies in the document root: every address under /uploads/ reaches index.php, whose light path serves a
    # public folder and refuses the rest. The prefix match with ^~ wins over any regex for static files below.
    location ^~ /uploads/ {
        rewrite ^ /index.php last;
    }

    # The PHP and the markup of the themes are assembled by PHP, no browser fetches them
    location ~* ^/templates/(?:.*\.php|[^/]+/.*\.html)$ {
        return 404;
    }

    # A path after a script, such as /index.php/index.php, runs that script, which answers 301 to its own address
    location ~ ^(.+?\.php)/ {
        rewrite ^(.+?\.php)/ $1 last;
    }

    # Browser cache lifetimes of the static files, revalidated by ETag; a missing one reaches the front controller and its 404
    location ~* \.(?:css|js|mjs)$ {
        try_files $uri /index.php?$args;
        add_header Cache-Control $asset_cache;
    }

    location ~* \.(?:woff2?|ttf|otf|eot|jpe?g|png|gif|webp|avif|svg|ico|mp3|ogg|wav)$ {
        try_files $uri /index.php?$args;
        add_header Cache-Control "public, max-age=604800";
    }

    # A missing file or folder goes to the front controller, as the rewrite of public/.htaccess does; a path that is no address of the site finds its 404 there
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $fastcgi_script_name =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }
}
