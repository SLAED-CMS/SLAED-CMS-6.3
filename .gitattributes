# Force LF line endings for all text files
* text=auto eol=lf

# Source code
*.php text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.tpl text eol=lf

# Config & docs
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.htaccess text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.bz2 binary
*.pdf binary

# Kept in the repository and on the stand, never in a release archive (docs/UPDATE.md)
/public/update.php export-ignore
/storage/update/sql/table_update6_3.sql export-ignore
# The master of updates runs only on slaed.net and reaches it by SFTP; a site never receives it
/modules/master export-ignore
# The changelog of the project is a module of slaed.net too, with the templates only it renders; tools/release.php build drops the rows of both from config/modules.php
/modules/changelog export-ignore
/public/templates/*/fragments/changelog-*.html export-ignore
/public/templates/*/partials/changelog*.html export-ignore
# A release carries only what a site runs: the tests, the tools, the documents, the stands and the files of development stay here
/tests export-ignore
/tools export-ignore
/docs export-ignore
/public/demo export-ignore
/public/phoenix export-ignore
/composer.json export-ignore
/package.json export-ignore
/phpunit.xml export-ignore
/phpstan.neon export-ignore
/phpstan-bootstrap.php export-ignore
/phpstan-stubs.php export-ignore
/.php-cs-fixer.dist.php export-ignore
/.editorconfig export-ignore
/.gitmessage export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/README.md export-ignore
/UPGRADING.md export-ignore
/SECURITY.md export-ignore
/CONTRIBUTING.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
