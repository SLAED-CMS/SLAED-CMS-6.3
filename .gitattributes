# Force LF line endings for all text files
* text=auto eol=lf

# Source code
*.php text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.tpl text eol=lf

# Config & docs
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.htaccess text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.bz2 binary
*.pdf binary

# Kept in the repository and on the stand, never in a release archive (docs/11-UPDATE-2026.md)
/public/update.php export-ignore
/storage/update/sql/table_update6_3.sql export-ignore
# The master of updates runs only on slaed.net and reaches it by SFTP; a site never receives it
/modules/master export-ignore
