parameters:
    level: 0
    bootstrapFiles:
        - phpstan-bootstrap.php
    paths:
        - core
        - modules
    excludePaths:
        - modules/*/admin/info/*
        - modules/clients/pclzip.lib.php (?)
        - plugins/*
        - vendor/*
    ignoreErrors:
        - '#Undefined variable: \$uname#'
        - '#Function whois invoked with 0 parameters#'
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
