# SLAED CMS - Git Ignore

# Storage directories
/storage/cache/*
/storage/logs/*
/storage/counter/*
/storage/backup/*
/storage/layout/*
/storage/sitemap/*
!/storage/sitemap/sitemap.xsl
/storage/captcha/*
/storage/baseline/*
/storage/migrate/*

# The updater: what a site writes for itself, what only the master holds, the list a release archive brings, and the releases the owner builds
/storage/update/client/
/storage/update/master/
/config/master.php
/storage/update/files.json
/storage/release/

# Uploads are the files of a site, the production copy on the stand among them; only the shipped presentation assets are tracked
/uploads/*
!/uploads/presentation/

# Written by the scheduler job sitemap when the site turns it on; a shipped copy would carry the addresses of the stand
/public/sitemap.xml


# Database configs (contains passwords)
/config/db.php

# API tokens and secrets
/config/changelog.php
/config/local.php
/tools/.env

# Markers of the self-check: a random body per installation, so a shipped copy would let a copy of the delivery pass for the site
/check.txt
/storage/check.txt
/config/check.txt
/uploads/check.txt
/admin/info/check.txt

# Marks of finished 6.3 data updates: written by setup.php or update.php on the site itself, a shipped mark would open a subsystem that was never updated
/config/update.php

# Backups
*.bak
*.backup
*.sql
!storage/update/sql/*.sql
!storage/update/step/*.sql
!modules/*/sql/*.sql
!tests/Fixtures/*/site.sql
*.zip
*.gz
*.tar

# Editor files
.claude/
.plans/
.rules/
/AGENTS.md
/CLAUDE.md
*.sublime-*
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*.pid
*.swp
*~

# Node modules (if using npm)
node_modules/
package-lock.json

# Composer
/vendor/
/composer.lock
/composer.phar

# PHPUnit
.phpunit.cache/
tests/coverage/

# PHP CS Fixer
.php-cs-fixer.cache

# Screenshot baselines: a full-page pixel set cannot be stable on a stand whose own content moves the page height,
# so the reference is captured per change into a temp directory by npm run ui:before / ui:after, never committed.
# The path still works locally; ignoring it keeps 80 MB of PNGs from returning to history by accident
/tools/ui-baseline/

# OS files
.DS_Store
desktop.ini
nul
