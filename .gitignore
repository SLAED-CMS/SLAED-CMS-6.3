# SLAED CMS - Git Ignore

# Storage directories
/storage/cache/*
/storage/logs/*
/storage/counter/*
/storage/backup/*
/storage/sitemap/*
!/storage/sitemap/sitemap.xsl
/storage/captcha/*
/storage/baseline/*
/storage/migrate/*

# Keep directory structure
!*/index.html
!*/.htaccess


# Database configs (contains passwords)
/config/db.php

# API tokens and secrets
/config/changelog.php
/config/local.php

# Backups
*.bak
*.backup
*.sql
!setup/sql/*.sql
*.zip
*.gz
*.tar

# Editor files
.agents/
.claude/
.prompts/
.rules/
/CLAUDE.md
/AGENTS.md
.idea/
docs/plans/
*.sublime-*
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*.pid
*.swp
*~

# Node modules (if using npm)
node_modules/
package-lock.json

# Composer
/vendor/
/composer.lock
/composer.phar

# PHPUnit
.phpunit.cache/
tests/coverage/

# PHP CS Fixer
.php-cs-fixer.cache

# Screenshot baselines: a full-page pixel set cannot be stable on a stand whose own content moves the page height,
# so the reference is captured per change into a temp directory by npm run ui:before / ui:after, never committed.
# The path still works locally; ignoring it keeps 80 MB of PNGs from returning to history by accident
/tools/ui-baseline/

# OS files
.DS_Store
desktop.ini
nul
