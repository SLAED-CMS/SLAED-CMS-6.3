# SLAED CMS - Git Ignore

# Storage directories
/storage/cache/*
/storage/logs/*
/storage/counter/*
/storage/backup/*
/storage/sitemap/*

# Config cache
/config/cache/*
/config/counter/*
/config/logs/*

# Keep directory structure
!*/index.html
!*/.htaccess

# Uploads (user content)
/uploads/*
!/uploads/index.html

# Database configs (contains passwords)
/config/db.php

# API tokens and secrets
/config/changelog.php

# Backups
*.bak
*.backup
*.sql
!setup/sql/*.sql
*.zip
*.gz
*.tar

# Editor files
.agents/
.claude/
.prompts/
.rules/
.idea/
docs/plans/
*.sublime-*
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*.pid
*.swp
*~

# Node modules (if using npm)
node_modules/
package-lock.json

# Composer
/vendor/
/composer.lock
/composer.phar

# PHPUnit
.phpunit.cache/
tests/coverage/

# OS files
.DS_Store
desktop.ini
nul
